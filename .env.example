# Phonebook backend configuration.
# Copy this file to `.env` (project root or backend/) and adjust the values.
# Real environment variables always win over this file.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=phonebook_db
DB_USER=phonebook_app
DB_PASSWORD=CHANGE_ME

# HTTP port of the Clojure API server
PORT=3000

# Comma separated list of browser origins allowed by CORS (the shadow-cljs dev server)
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# Login session lifetime in hours (default 168 = 7 days)
AUTH_TOKEN_TTL_HOURS=168
